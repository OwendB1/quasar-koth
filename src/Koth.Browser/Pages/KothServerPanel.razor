@using Microsoft.AspNetCore.Components
@implements IDisposable

<details class="quasar-panel koth-server-panel" open="@expanded">
    <summary @onclick="Toggle" @onclick:preventDefault="true"><h2>@Server.DisplayName</h2></summary>
    @if (expanded)
    {
        <div class="koth-server-content" aria-busy="@busy">
            @if (error.Length > 0) { <p class="koth-error" role="alert">@error</p> }
            @if (message.Length > 0) { <p role="status">@message</p> }
            @if (snapshot == null && busy) { <p role="status">Loading KOTH scores…</p> }
            @if (snapshot != null)
            {
                <p role="status">@snapshot.Status</p>
                @if (snapshot.Available)
                {
                    <p>World: <strong>@snapshot.World</strong> · Read at @snapshot.CapturedUtc.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture) · Updates every 5 seconds while expanded.</p>
                    @if (Server.ClusterId.Length > 0)
                    { <p>These are this node's scores. Replicated scores are not added together. Cluster reset is unavailable.</p> }
                    <div class="koth-table-scroll" tabindex="0" role="region" aria-label="@($"KOTH faction scores for {Server.DisplayName}")">
                        <table>
                            <caption>Scores by planet and faction</caption>
                            <thead><tr><th scope="col">Planet</th><th scope="col">Faction</th><th scope="col">Tag</th><th scope="col">Points</th><th scope="col">Last scoring grid</th></tr></thead>
                            <tbody>
                                @foreach (var score in snapshot.Scores)
                                { <tr><td>@score.Planet</td><th scope="row">@score.FactionName</th><td>@score.FactionTag</td><td>@score.Points</td><td>@score.GridName</td></tr> }
                            </tbody>
                        </table>
                    </div>
                    @if (snapshot.Scores.Count == 0) { <p>No KOTH scores yet.</p> }
                    @if (CanControlServers)
                    {
                        <details class="koth-reset-panel">
                            <summary>Reset all KOTH scores</summary>
                            <p>This clears every faction's score in this world. A verified XML backup is saved first. Capture progress and prizes remain controlled by the mod.</p>
                            <p>@snapshot.ResetStatus</p>
                            <dl><dt>Server ID</dt><dd><code>@Server.ServerId</code></dd><dt>World stream ID</dt><dd><code>@snapshot.StreamId</code></dd></dl>
                            <label for="@confirmationId">Type RESET to confirm</label>
                            <input id="@confirmationId" @bind="confirmation" @bind:event="oninput" autocomplete="off" disabled="@busy" />
                            <button type="button" class="koth-danger" @onclick="Reset" disabled="@(busy || !snapshot.ResetSupported || confirmation != "RESET" || Server.ClusterId.Length > 0)">Back up and reset scores</button>
                        </details>
                    }
                }
            }
            @if (CanManageDiscord)
            {
                <p role="status">@deliveryMessage</p>
            }
        </div>
    }
</details>

@code {
    [Parameter, EditorRequired] public KothServer Server { get; set; } = default!;
    [Parameter] public bool CanManageDiscord { get; set; }
    [Parameter] public bool CanControlServers { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private readonly string confirmationId = "koth-reset-confirm-" + Guid.NewGuid().ToString("N");
    private KothSnapshot? snapshot;
    private string error = "", message = "", confirmation = "", deliveryMessage = "";
    private bool expanded, busy;

    protected override void OnInitialized() => _ = WatchScoresAsync(lifetime.Token);

    private async Task Toggle()
    {
        expanded = !expanded;
        confirmation = "";
        if (expanded) await LoadScores();
    }
    private async Task LoadScores()
    {
        if (busy) return;
        busy = true; error = "";
        try
        {
            var current = await Ui.CallAsync<KothSnapshot>("scores.read", new ServerRequest(Server.ServerId), lifetime.Token);
            if (snapshot?.StreamId != current.StreamId) confirmation = "";
            snapshot = current;
            try
            {
                if (CanManageDiscord)
                    deliveryMessage = (await Ui.CallAsync<DeliveryStatus>("discord.status", new ServerRequest(Server.ServerId), lifetime.Token)).Message;
            }
            catch (Exception failure) when (failure is not OperationCanceledException)
            { deliveryMessage = "Could not load delivery status: " + failure.GetBaseException().Message; }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception failure)
        {
            snapshot = null; confirmation = "";
            error = "Could not load KOTH scores: " + failure.GetBaseException().Message;
        }
        finally { busy = false; }
    }
    private async Task WatchScoresAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (!expanded) continue;
                await InvokeAsync(async () =>
                {
                    token.ThrowIfCancellationRequested();
                    if (!expanded) return;
                    await LoadScores(); StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }
    private async Task Reset()
    {
        if (busy || snapshot == null) return;
        busy = true; error = ""; message = "";
        try
        {
            var result = await Ui.CallAsync<ResetResult>("scores.reset", new ResetScoresRequest(Server.ServerId, snapshot.StreamId, confirmation), lifetime.Token);
            snapshot = result.Snapshot; confirmation = "";
            message = "Scores reset. Backup in KOTH world storage: " + result.BackupFile;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception failure) { error = failure.GetBaseException().Message; }
        finally { busy = false; }
    }
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
