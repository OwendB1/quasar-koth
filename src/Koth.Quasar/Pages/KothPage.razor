@page "/koth"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using global::Quasar.Plugin.Abstractions.Security
@attribute [Authorize(Policy = QuasarPolicyNames.CanView)]
@implements IDisposable
@inject KothUiClient Ui

<PageTitle>King of the Hill</PageTitle>
<section class="koth-page" aria-labelledby="koth-title">
    <header class="quasar-page-heading">
        <div class="quasar-page-intro">
            <div class="quasar-eyebrow">Operations</div>
            <h1 id="koth-title">King of the Hill</h1>
            <div class="quasar-page-description">Expand a server to view live faction scores from its KOTH world.</div>
        </div>
    </header>
    @if (error.Length > 0) { <p class="koth-error" role="alert">@error</p> }
    @if (message.Length > 0) { <p role="status">@message</p> }
    @if (serverError.Length > 0) { <p class="koth-error" role="alert">@serverError</p> }
    @if (servers.Count == 0 && serverError.Length == 0)
    { <p>No game servers are connected. Start a managed server with the companion enabled.</p> }
    <div class="koth-server-panels" aria-label="Game servers and nodes">
        @foreach (var server in servers)
        {
            <KothServerPanel @key="server.ServerId" Server="server" />
        }
    </div>
    <AuthorizeView Policy="@QuasarPolicyNames.CanManageDiscord">
        <section class="quasar-panel koth-card" aria-labelledby="koth-discord-title" aria-busy="@busy">
            <h2 id="koth-discord-title">Discord announcements</h2>
            <p>Use Quasar's existing bot with a dedicated KOTH text channel in its configured Discord server.</p>
            <p id="koth-channel-help">In Discord, enable Developer Mode under Advanced settings, then right-click the KOTH channel and choose Copy Channel ID. Give Quasar's bot View Channel and Send Messages permissions.</p>
            <label for="koth-channel">KOTH channel ID</label>
            <input id="koth-channel" inputmode="numeric" maxlength="20" @bind="channelId" aria-describedby="koth-channel-help" disabled="@busy" />
            <label class="koth-check"><input type="checkbox" @bind="announcementsEnabled" disabled="@busy" /> Send capture announcements</label>
            <div class="koth-toolbar">
                <button type="button" @onclick="SaveSettings" disabled="@busy">Save Discord settings</button>
                <button type="button" @onclick="TestDiscord" disabled="@busy">Test saved channel</button>
            </div>
        </section>
    </AuthorizeView>
    <footer><a href="https://github.com/OwendB1/quasar-koth">KOTH plugin source code</a> · AGPL-3.0-only</footer>
</section>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private IReadOnlyList<KothServer> servers = [];
    private string error = "", message = "", serverError = "", channelId = "";
    private bool busy, announcementsEnabled;

    protected override async Task OnInitializedAsync()
    {
        await Run(async () =>
        {
            await LoadServers();
            if (await Ui.CanAsync(QuasarPolicyNames.CanManageDiscord))
            {
                var settings = await Ui.CallAsync<KothSettings>("settings.read", new { }, lifetime.Token);
                channelId = settings.DiscordChannelId; announcementsEnabled = settings.AnnouncementsEnabled;
            }
        });
        if (!lifetime.IsCancellationRequested) _ = WatchServersAsync(lifetime.Token);
    }
    private async Task LoadServers()
    {
        try
        {
            servers = await Ui.CallAsync<IReadOnlyList<KothServer>>("servers.list", new { }, lifetime.Token);
            serverError = "";
        }
        catch (Exception failure) when (failure is not OperationCanceledException)
        { serverError = "Could not update connected servers: " + failure.GetBaseException().Message; }
    }
    private async Task WatchServersAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
                await InvokeAsync(async () =>
                {
                    token.ThrowIfCancellationRequested();
                    await LoadServers();
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }
    private async Task Run(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = ""; message = "";
        try { await action(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception failure) { error = failure.GetBaseException().Message; }
        finally { busy = false; }
    }
    private Task SaveSettings() => Run(async () =>
    {
        await Ui.CallAsync<KothSettings>("settings.set", new KothSettings(announcementsEnabled, channelId.Trim()), lifetime.Token);
        message = "KOTH Discord settings saved.";
    });
    private Task TestDiscord() => Run(async () =>
    {
        await Ui.CallAsync<bool>("discord.test", new { }, lifetime.Token);
        message = "Test message sent through Quasar's bot.";
    });
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
